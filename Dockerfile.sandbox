# The image for the agent's bash sandbox (the SandboxTemplate's container).
#
# It is the upstream agent-sandbox runtime plus the libraries and tools the agent
# needs for files: images, Office, PDF, plots. Without them the agent hit
# "No module named 'PIL'" and had to work around it, and the `bash` tool description
# promised libraries that were not there.
#
# The base is pinned by digest, not by the moving `latest-main` tag, so rebuilding
# this image cannot change the runtime server (main.py, the :8888 API) underneath us.
# To move to a newer runtime, change the digest on purpose and re-test.
ARG BASE=us-central1-docker.pkg.dev/k8s-staging-images/agent-sandbox/python-runtime-sandbox@sha256:a59e223cacd381c25cbaa8a553dc9d986b3a00a991fd984a2e20826c75ec9b06
FROM ${BASE}

USER root

# Command-line tools. `file`, `unzip` and friends are what an agent reaches for first;
# pandoc converts documents; poppler gives pdftotext/pdftoppm; tesseract reads text out
# of images (with English, Vietnamese, Japanese, Chinese, Korean, Russian, Thai, Arabic, French, German and Spanish data) and, through pytesseract, reports where
# each word is, which a model looking at a picture cannot do by eye. The fonts are what
# matplotlib, reportlab and rendered pages use.
RUN apt-get update && apt-get install -y --no-install-recommends \
        file curl unzip zip jq \
        pandoc poppler-utils \
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-vie \
        tesseract-ocr-jpn tesseract-ocr-chi-sim tesseract-ocr-chi-tra tesseract-ocr-kor tesseract-ocr-rus tesseract-ocr-tha tesseract-ocr-ara tesseract-ocr-fra tesseract-ocr-deu tesseract-ocr-spa \
        fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

COPY sandbox/requirements.txt sandbox/requirements-nodeps.txt /tmp/sandbox/

# The constraints file freezes what the runtime already has (fastapi, uvicorn,
# pydantic, numpy, pandas...), so installing these cannot upgrade them: pip fails
# the build instead of breaking the server.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip freeze > /tmp/sandbox/constraints.txt \
    && pip install --only-binary=:all: -c /tmp/sandbox/constraints.txt -r /tmp/sandbox/requirements.txt \
    && pip install --only-binary=:all: --no-deps -r /tmp/sandbox/requirements-nodeps.txt \
    && rm -rf /tmp/sandbox

# Back to the unprivileged user the base runs as.
USER 1000
