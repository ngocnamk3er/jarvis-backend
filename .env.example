APP_NAME=Jarvis
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api/v1

OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
TAVILY_API_KEY=tvly-...
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5433/jarvis

# jarvis-conversation-service — owns conversations/subagent_traces since the
# Chapter 2 decomposition. INTERNAL_API_KEY must match that service's own.
CONVERSATION_SERVICE_URL=http://localhost:8001
# jarvis-file-service — owns the per-user file workspace. Same shared
# INTERNAL_API_KEY as above.
FILE_SERVICE_URL=http://localhost:8002
INTERNAL_API_KEY=changeme-dev-only

# Directory on the host where per-conversation sandbox folders are created
# SANDBOX_DATA_DIR=/absolute/path/to/data/sandboxes
